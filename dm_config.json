{
  "experiment": {
    "name": "loopback_diffusion",
    "seed": 42,
    "model_type": "ddim"
  },

  "dataset": {
    "path": "data/datos_loopback/new_ch_time_worst.npy",
    "type": "loopback"
  },

  "model": {
    "time_emb_dim": 64
  },

  "diffusion": {
    "T": 1000,
    "schedule": "cosine",
    "use_tap_weights": true
  },

  "training": {
    "epochs": 500,
    "batch_size": 64,
    "lr": 0.0002,
    "patience": 80,
    "min_delta": 0.000005,
    "num_workers": 0,
    "grad_clip": 1.0
  },

  "paths": {
    "save_dir": "checkpoints/datos_loopback/ddim",
    "best_model": "best_model.pth",
    "log_dir": "logs"
  }
}