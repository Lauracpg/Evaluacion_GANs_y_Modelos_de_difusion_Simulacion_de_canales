{
  "experiment": {
    "name": "synthetic_diffusion",
    "seed": 42
  },

  "dataset": {
    "path": "../data/datos_NIST/h_AAplant_5G/h_AAplant_5G.npy",
    "type": "NIST"
  },

  "model": {
    "time_emb_dim": 32
  },

  "diffusion": {
    "schedule": "cosine",
    "use_tap_weights": true,
    "T": 500
  },

  "training": {
    "epochs": 500,
    "batch_size": 64,
    "lr": 0.0002,
    "patience": 50,
    "min_delta": 0.001,
    "num_workers": 0,
    "grad_clip": 5.0
  },

  "paths": {
    "save_dir": "../checkpoints/datos_NIST/h_AAplant_5G/DDIM/ddim_T500_lr0.0002_te32",
    "best_model": "best_model.pth"
  }
}