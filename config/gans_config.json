{
  "experiment": {
    "name": "conv1d_wgan",
    "seed": 42,
    "model_type": "wgan"
  },

  "dataset": {
    "path": "../data/datos_NIST/h_AAplant_5G/h_AAplant_5G.npy"
  },

  "model": {
    "z_dim": 128,
    "signal_length": 128
  },

  "training": {
    "epochs": 400,
    "batch_size": 64,
    "lr": 0.0001,

    "gan": {
      "betas": [0.5, 0.999]
    },

    "wgan": {
      "betas": [0.0, 0.9],
      "n_critic": 10,
      "lambda_gp": 10.0,
      "lambda_spec": 0.01
    },
    "patience": 150,
    "min_delta": 0.0001
  },

  "paths": {
    "save_dir": "../checkpoints/datos_NIST/h_AAplant_5G/wgan_z128_lr0.0001_bs64_lspec0.01",
    "best_model": "best_model.pth"
  }
}