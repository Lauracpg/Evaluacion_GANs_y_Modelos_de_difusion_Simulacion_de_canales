{
  "experiment": {
    "name": "conv1d_wgan",
    "seed": 42,
    "model_type": "wgan"
  },

  "dataset": {
    "path": "data/datos_loopback/new_ch_time_worst.npy"
  },

  "model": {
    "z_dim": 128,
    "signal_length": 200
  },

  "training": {
    "epochs": 800,
    "batch_size": 64,
    "lr": 0.00005,
    "gan": {
      "betas": [0.5, 0.999]
    },

    "wgan": {
      "betas": [0.0, 0.99],
      "n_critic": 5,
      "lambda_gp": 10.0
    },
    "patience": 120,
    "min_delta": 0.0001
  },

  "loss": {
    "gan": "bce",
    "wgan": "wgan_gp"
  },

  "paths": {
    "save_dir": "checkpoints/datos_loopback/WGAN_Conv1D",
    "best_model": "best_model.pth"
  }
}