{
  "experiment": {
    "name": "conv1d_wgan",
    "seed": 42,
    "model_type": "wgan"
  },

  "dataset": {
    "path": "data/datos_loopback/new_ch_time_worst.npy"
  },

  "model": {
    "z_dim": 64,
    "signal_length": 200,
    "generator": {
      "init_channels": 128,
      "channels": [128, 64, 32],
      "output_channels": 2,
      "kernel_size_last": 3
    },
    "discriminator": {
      "input_channels": 2,
      "channels": [32, 64, 128],
      "use_spectral_norm": true
    }
  },

  "training": {
    "epochs": 300,
    "batch_size": 64,
    "lr": 0.0001,
    "optimizer_betas_gan": [0.5, 0.999],
    "optimizer_betas_wgan": [0.0, 0.9],
    "n_critic": 3,
    "lambda_gp": 5.0,
    "patience": 80,
    "min_delta": 0.0002
  },

  "loss": {
    "type": "wgan_gp"
  },

  "paths": {
    "save_dir": "checkpoints/datos_loopback/WGAN_Conv1D",
    "best_model": "best_model.pth"
  }
}